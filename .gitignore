# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# 모바일 앱(mobile/) — 소스와 설정은 올리고, 서명 열쇠·비밀번호·빌드 결과물·내 컴퓨터 경로는 올리지 않습니다
/mobile/android/keys/
/mobile/android/local.properties
/mobile/android/.gradle/
/mobile/android/build/
/mobile/android/app/build/
/mobile/**/*.apk
/mobile/**/*.aab
/mobile/**/*.idsig
*.jks
*.keystore
