# 같이가개 환경변수 목록 — 이 파일을 .env.local로 복사한 뒤 값을 채워주세요.
# 배포 시에는 호스팅(Vercel 등) 대시보드의 Environment Variables에 같은 이름으로 등록합니다.
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 노출되므로 비밀 키를 넣지 마세요.

# ── 사이트 ──
# 도메인 확정 후 설정(예: https://gachigage.com). 비워두면 Vercel 도메인 → localhost 순으로 대체
NEXT_PUBLIC_SITE_URL=

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용(RLS 우회) — 절대 NEXT_PUBLIC_로 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# ── 카카오 ──
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=
# 카카오 REST API 키 — 서버 전용(주소 검색·좌표→지역 변환·카카오 로그아웃). 브라우저에 노출되지 않게
# NEXT_PUBLIC_를 붙이지 않습니다. scripts/import-foodsafety-places.mjs 지오코딩에도 씁니다.
KAKAO_REST_API_KEY=

# ── 공공데이터 ──
# 한국관광공사 반려동물 동반여행
TOUR_API_KEY=
# 국가동물보호정보시스템 구조동물(유기동물 공고)
ANIMAL_OPEN_API_KEY=
# 국세청 사업자등록정보 진위확인(사장님 자동 인증) — 공공데이터포털에서 이 API 활용신청 필요
NTS_API_KEY=
# 전국도시공원 (scripts/import-parks.mjs)
PARK_OPEN_API_KEY=

# ── 도보 경로(TMAP) ──
# 미설정 시 /api/route/walk는 501을 반환하고 AI 코스는 추정 도보거리를 사용
TMAP_APP_KEY=
# 하루 전체 호출 한도(기본 800)
TMAP_DAILY_LIMIT=

# ── 제보 이미지 AI 검증 ──
# 미설정 시 AI 검증 없이 모든 제보가 관리자 수동 검토로 넘어감
ANTHROPIC_API_KEY=

# ── 추천 A/B 테스트 ──
# v2 그룹 배정 비율(0~100, 기본 100). 50이면 A/B 비교, 0이면 전원 v1(롤백)
NEXT_PUBLIC_REC_V2_ROLLOUT=

# ── 공공데이터 자동 갱신(Vercel Cron) ──
# /api/cron/sync-public-data 보호용 비밀값(임의의 긴 문자열). Vercel이 크론 호출 때 자동으로 실어 보냅니다.
CRON_SECRET=

# 카카오톡 관리자 알림(나에게 보내기) — 관리자 화면 > 대시보드에서 연결
# APP_ENCRYPTION_KEY: 연결 권한(토큰)을 암호화해 보관할 때 쓰는 임의의 긴 문자열(예: openssl rand -hex 32)
APP_ENCRYPTION_KEY=
# 카카오 개발자 콘솔 > 앱 > 보안 > Client Secret을 "사용함"으로 켜 둔 경우에만 그 코드를 넣으세요
KAKAO_CLIENT_SECRET=

# 카카오 어드민 키(앱 > 어드민 키) — 연결 해제 웹훅(/api/kakao/unlink) 확인과, 탈퇴 시 카카오 연결 해제 요청에 사용.
# 매우 민감한 키라 절대 NEXT_PUBLIC_을 붙이지 말고 채팅·코드에 붙이지 마세요.
KAKAO_ADMIN_KEY=
